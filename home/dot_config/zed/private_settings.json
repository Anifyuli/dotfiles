// APPEARANCE
{
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "Gruvbox Dark",
  },
  "icon_theme": {
    "mode": "system",
    "dark": "Modern Icons (Dark)",
    "light": "Modern Icons (Light)",
  },
  "buffer_font_family": "BlexMono Nerd Font",
  "buffer_font_features": { "calt": true },
  "buffer_font_size": 14,
  "buffer_font_weight": 500,
  "buffer_line_height": "comfortable",
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 16,
  "ui_font_weight": 800,

  // EDITOR BEHAVIOR
  "autosave": "on_focus_change",
  "ensure_final_newline_on_save": false,
  "soft_wrap": "editor_width",
  "show_wrap_guides": true,
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "code_lens": "on",
  "linked_edits": true,
  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "show_edit_predictions": true,
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "gutter": {
    "line_numbers": true,
    "folds": true,
  },

  // VIM
  "vim_mode": true,
  "vim": {
    "use_system_clipboard": "on_yank",
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },

  // GIT
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
  },

  // TERMINAL
  "terminal": {
    "default_height": 270.0,
    "shell": {
      "with_arguments": {
        "program": "/usr/bin/fish",
        "args": ["-c", "tmux new-session -A -s \"$(basename \"$PWD\")\""],
      },
    },
  },

  // AI / AGENT
  "edit_predictions": {
    "mode": "eager",
    "provider": "codestral",
    "codestral": {
      "model": "codestral-latest",
      "api_url": "https://codestral.mistral.ai/v1/fim/completions",
    },
  },
  "agent": {
    "dock": "right",
    "enabled": true,
    "default_profile": "ask",
    "default_model": {
      "provider": "mistral",
      "model": "mistral-medium-3.5",
      "enable_thinking": true,
    },
    "inline_assistant_model": {
      "provider": "mistral",
      "model": "codestral-latest",
    },
  },
  "language_models": {},
  "agent_servers": {
    "kilo": { "type": "registry" },
    "gemini": { "type": "registry" },
    "opencode": { "type": "registry" },
    "mistral-vibe": { "type": "registry" },
    "qwen-code": { "type": "registry" },
  },

  // PANELS & LAYOUT
  "bottom_dock_layout": "full",
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "right" },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true,
  },
  "tab_bar": {
    "show": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
    "show_close_button": "always",
  },
  "file_finder": {
    "file_icons": true,
  },

  // LANGUAGES
  "languages": {
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
      ],
    },
    "HTML": {
      "formatter": "auto",
    },
    "JavaScript": {
      "language_servers": ["vtsls"],
      "format_on_save": "on",
    },
    "TypeScript": {
      "language_servers": ["vtsls"],
      "format_on_save": "on",
    },
    "TSX": {
      "language_servers": ["eslint", "tailwindcss-intellisense-css", "vtsls"],
      "format_on_save": "on",
    },
    "PHP": {
      "language_servers": ["eslint", "phpactor", "vscode-html-languageservice"],
      "formatter": "language_server",
      "format_on_save": "off",
    },
    "kulala-http": {
      "language_servers": ["kulala-ls"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "kulala-fmt",
          "arguments": ["format", "--stdin", "{buffer_path}"],
        },
      },
    },
  },

  // LSP
  "lsp": {
    "vtsls": {
      "settings": {
        "javascript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": { "enabled": true },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "enumMemberValues": { "enabled": true },
          },
        },
        "typescript": {
          "inlayHints": {
            "parameterNames": {
              "enabled": "all",
              "suppressWhenArgumentMatchesName": false,
            },
            "parameterTypes": { "enabled": true },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true,
            },
            "propertyDeclarationTypes": { "enabled": true },
            "functionLikeReturnTypes": { "enabled": true },
            "enumMemberValues": { "enabled": true },
          },
        },
      },
    },
    "eslint": {
      "settings": {
        "codeActionOnSave": {
          "rules": ["import/order"],
        },
      },
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": [
            "\\.className\\s*[+]?=\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttributeNS\\(.*,\\s*['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.setAttribute\\(['\"]class['\"],\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.add\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.remove\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.toggle\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.contains\\(['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\(\\s*['\"]([^'\"]*)['\"]",
            "\\.classList\\.replace\\([^,)]+,\\s*['\"]([^'\"]*)['\"]",
          ],
        },
      },
    },
    "vscode-html-language-server": {
      "settings": {
        "format": {
          "contentUnformatted": ["svg", "script"],
        },
      },
    },
    "kulala-http": {
      "binary": {
        "path": "kulala-ls",
        "arguments": ["--stdio"],
      },
    },
  },

  // EXTENSIONS & MISC
  "auto_install_extensions": {
    "editorconfig": true,
    "emmet": true,
    "gruvbox-material": true,
    "html": true,
    "kulala-http": true,
    "modern-icons": true,
    "php": true,
    "react-type-kit-snippets": true,
    "sql": true,
    "wakatime": true,
    "zed-react-snippets": true,
  },
  "auto_update": false,
  "confirm_quit": true,
  "restore_on_startup": "last_workspace",
  "session": {
    "trust_all_worktrees": true,
  },
  "profiles": {},
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
  ],
}
