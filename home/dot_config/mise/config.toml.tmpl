[env]
GOBIN = "{{ env "HOME" }}/.local/bin"
GOPATH = "{{ env "HOME" }}/.go"
OPENCODE_DISABLE_FFF=1

{{ if eq .chezmoi.hostname "ThinkPad-L15G2a" }}
[bootstrap.hooks.pre-packages]
run = [
  "chmod +x ~/.local/bin/mise-ensure-repo",
  "mise-ensure-repo remi",
  "mise-ensure-repo remi-module:remi-8.3",
  "mise-ensure-repo terra",
  "mise-ensure-repo docker-ce",
]

[bootstrap.packages]
"dnf:composer" = "latest"
"dnf:containerd.io" = "latest"
"dnf:docker-buildx-plugin" = "latest"
"dnf:docker-ce" = "latest"
"dnf:docker-ce-cli" = "latest"
"dnf:docker-compose-plugin" = "latest"
"dnf:php" = "latest"
"dnf:php-cli" = "latest"
"dnf:php-fpm" = "latest"
"dnf:php-mbstring" = "latest"
"dnf:php-xml" = "latest"
"dnf:php-mysqlnd" = "latest"
"dnf:php-pgsql" = "latest"
"dnf:php-gd" = "latest"
"dnf:php-bcmath" = "latest"
"dnf:php-pecl-zip" = "latest"
"dnf:php-opcache" = "latest"
"dnf:php-sodium" = "latest"
"dnf:nginx" = "latest"
"dnf:postgresql" = "latest"
"dnf:postgresql-server" = "latest"

[bootstrap.hooks.post-packages]
run = [
  "sudo systemctl daemon-reload",
  "sudo systemctl enable --now docker",
]
{{ else }}
[bootstrap.hooks.pre-packages]
run = [
  "chmod +x ~/.local/bin/mise-ensure-repo",
  "mise-ensure-repo terra",
]
{{ end }}

[tools]
flutter = "latest"
go      = "latest"
gradle = "latest"
java   = "openjdk-21"
node   = "latest"
opencode = "latest"
pnpm   = "latest"
yarn   = "latest"
usage  = "latest"
uv     = "latest"

{{ if eq .chezmoi.hostname "ThinkPad-L15G2a" }}
# Github backend
"github:phpactor/phpactor" = "latest"
{{ end }}

# Go backend
"go:golang.org/x/tools/gopls" = "latest"

# npm packages
"npm:@mistweaverco/kulala-ls"   = "latest"
"npm:@mistweaverco/kulala-fmt"  = "latest"
"npm:@nestjs/cli"               = "latest"
"npm:prettier"                  = "latest"
"npm:httpyac"                   = "latest"
"npm:eas-cli"                   = "latest"

[settings]
experimental = true
node.corepack = true
npm.package_manager = "npm"
