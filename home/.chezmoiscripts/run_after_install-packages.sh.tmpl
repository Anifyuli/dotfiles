#!/usr/bin/env bash
set -euo pipefail
# Install packages declared in .chezmoidata/packages.yaml.
# Runs on every apply (run_after); self-healing: installs anything newly
# declared or previously failed. Each body is idempotent via rpm -q.
{{ if eq .chezmoi.os "linux" }}
for pkg in \
{{ range .packages.dnf_common -}}
  {{ . | quote }} \
{{ end -}}
{{ range (index .packages.dnf .chezmoi.hostname) -}}
  {{ . | quote }} \
{{ end -}}
; do
  if [[ "$pkg" == *:* ]]; then
    repo_tag="${pkg%%:*}"
    repo_tag="${repo_tag#kernel-}"
    repo_tag="${repo_tag//-/_}"
    name="${pkg#*:}"
    if ! rpm -q --last "$name" 2>/dev/null | head -n1 | grep -q "$repo_tag"; then
      echo "Installing $name (from ${pkg%%:*})..."
      sudo dnf install -y "$name"
    fi
  elif ! rpm -q "$pkg" >/dev/null 2>&1; then
    echo "Installing $pkg..."
    sudo dnf install -y "$pkg"
  fi
done
{{ end }}
