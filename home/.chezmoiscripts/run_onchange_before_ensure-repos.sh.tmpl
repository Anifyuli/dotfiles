#!/usr/bin/env bash
set -euo pipefail
# dnf repo ensure - controlled by chezmoi (run_onchange_before)
# Re-runs when content changes; idempotent per repo via rpm -q / grep guards.
# mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

ensure_remi() {
  rpm -q remi-release >/dev/null 2>&1 || \
    sudo dnf install -y "https://rpms.remirepo.net/fedora/remi-release-$(rpm -E %fedora).rpm"
}

ensure_remi_module() {
  local target="$1" cur
  cur="$(dnf module list --enabled php --cacheonly 2>/dev/null | awk '$1=="php" && $2 ~ /^remi-/{print $2; exit}' || true)"
  [ "$cur" = "$target" ] && return 0
  sudo dnf module reset php -y || true
  sudo dnf module enable "php:$target" -y
  if rpm -q php >/dev/null 2>&1; then
    sudo dnf distro-sync -y
  fi
}

ensure_terra() {
  rpm -q terra-release >/dev/null 2>&1 || \
    sudo dnf install -y --nogpgcheck \
      --repofrompath "terra,https://repos.fyralabs.com/terra$(rpm -E %fedora)" terra-release
}

ensure_onlyoffice() {
  rpm -q onlyoffice-repo >/dev/null 2>&1 || \
    sudo dnf install -y "https://download.onlyoffice.com/repo/centos/main/noarch/onlyoffice-repo.noarch.rpm"
}

ensure_docker_ce() {
  if ! grep -q 'download.docker.com' /etc/yum.repos.d/docker-ce.repo 2>/dev/null; then
    curl -fsSLo /tmp/docker-ce.repo https://download.docker.com/linux/fedora/docker-ce.repo
    sudo sed -i '/autorefresh/d' /tmp/docker-ce.repo
    sudo mv /tmp/docker-ce.repo /etc/yum.repos.d/
  fi
}

ensure_vscode() {
  if ! grep -q 'packages.microsoft.com/yumrepos/vscode' /etc/yum.repos.d/vscode.repo 2>/dev/null; then
    sudo rpm --import https://packages.microsoft.com/keys/microsoft.asc
    sudo tee /etc/yum.repos.d/vscode.repo >/dev/null <<'EOF'
[code]
name=Visual Studio Code
baseurl=https://packages.microsoft.com/yumrepos/vscode
enabled=1
autorefresh=1
type=rpm-md
gpgcheck=1
gpgkey=https://packages.microsoft.com/keys/microsoft.asc
EOF
  fi
}

ensure_gh_rpm() {
  local spec="$1" slug rest pattern json tag asset url fname stem name cur
  slug="${spec%%:*}"
  rest="${spec#*:}"
  if [ "$rest" = "$spec" ]; then
    pattern='*RHEL*x86_64*.rpm'
  else
    pattern="$rest"
  fi
  json="$(curl -fsSL "https://api.github.com/repos/$slug/releases/latest")"
  tag="$(printf '%s' "$json" | grep -oP '"tag_name":\s*"\K[^"]+' | head -n1)"
  tag="${tag#v}"
  asset=""
  while IFS= read -r url; do
    case "$url" in
      $pattern) asset="$url"; break ;;
    esac
  done < <(printf '%s' "$json" | grep -oP '"browser_download_url":\s*"\K[^"]+')
  if [ -z "$asset" ]; then
    echo "ensure-repos: no release asset matching '$pattern' for $slug" >&2
    exit 1
  fi
  fname="${asset##*/}"
  stem="${fname%.rpm}"
  stem="${stem%.*}"
  [[ "$stem" =~ \.[A-Za-z]+$ ]] && stem="${stem%.*}"
  name="${stem%%-*}"
  cur="$(rpm -q --queryformat '%{VERSION}' "$name" 2>/dev/null || true)"
  if [ -n "$cur" ] && [ "$cur" = "$tag" ]; then
    return 0
  fi
  sudo dnf install -y "$asset"
}

ensure_copr() {
  local name="$1"
  dnf copr list 2>/dev/null | grep -q "$name" || sudo dnf copr enable -y "$name"
}

ensure_remi
ensure_terra
ensure_onlyoffice
{{ range .packages.copr_common -}}
ensure_copr {{ . | quote }}
{{ end -}}
{{ range (index .packages.copr .chezmoi.hostname) -}}
ensure_copr {{ . | quote }}
{{ end -}}
ensure_gh_rpm alexandrehtrb/Pororoca

{{ if eq .chezmoi.hostname "ThinkPad-L15G2a" }}
ensure_remi_module remi-8.3
ensure_docker_ce
{{ else }}
ensure_remi_module remi-7.4
{{ end }}

{{ if eq .chezmoi.hostname "ThinkPad-X280" }}
ensure_vscode
{{ end }}