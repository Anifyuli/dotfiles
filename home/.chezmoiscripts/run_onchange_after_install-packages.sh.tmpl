#!/usr/bin/env bash
set -euo pipefail
# Install packages declared in .chezmoidata/packages.yaml.
# Declarative: re-runs only when the package list changes (run_onchange)
# renders this file; each body is idempotent via rpm -q.
{{ if eq .chezmoi.os "linux" }}
for pkg in \
{{ range .packages.dnf_common -}}
  {{ . | quote }} \
{{ end -}}
{{ range (index .packages.dnf .chezmoi.hostname) -}}
  {{ . | quote }} \
{{ end -}}
; do
  if ! rpm -q "$pkg" >/dev/null 2>&1; then
    echo "Installing $pkg..."
    sudo dnf install -y "$pkg"
  fi
done

{{ with index .packages.kernel_copr .chezmoi.hostname }}
kernel_repo={{ . | quote }}
kernel_tag="${kernel_repo#*/kernel-}"
kernel_tag="${kernel_tag//-/_}"
if ! rpm -q --last kernel 2>/dev/null | head -n1 | grep -q "$kernel_tag"; then
  echo "Installing kernel from $kernel_repo..."
  sudo dnf install -y kernel kernel-devel kernel-modules-extra
fi
{{ end }}
{{ end }}